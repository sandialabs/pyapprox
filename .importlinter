[importlinter]
root_package = pyapprox
include_external_packages = True

# ── Contract 1: No circular dependencies between top-level modules ───────
[importlinter:contract:acyclic]
name = No circular dependencies between top-level modules
type = acyclic_siblings
ancestors =
    pyapprox
ignore_imports =
    # TECH DEBT: real cycle; potential fix: extract bayesian optimization into its own top-level module
    pyapprox.optimization.bayesian.fitter_adapter -> pyapprox.surrogates.gaussianprocess.fitters.maximum_likelihood_fitter
    pyapprox.optimization.bayesian.fitter_adapter -> pyapprox.surrogates.gaussianprocess.fitters.fixed_hyperparameter_fitter
    pyapprox.optimization.bayesian.fitter_adapter -> pyapprox.surrogates.gaussianprocess.fitters.incremental_fitter

# ── Contract 2: Foundation modules must not import domain modules ────────
[importlinter:contract:util-isolation]
name = util must not import domain modules
type = forbidden
source_modules =
    pyapprox.util
forbidden_modules =
    pyapprox.interface
    pyapprox.probability
    pyapprox.optimization
    pyapprox.implicitfunction
    pyapprox.ode
    pyapprox.surrogates
    pyapprox.inverse
    pyapprox.generative
    pyapprox.sensitivity
    pyapprox.pde
    pyapprox.statest
    pyapprox.expdesign

[importlinter:contract:interface-isolation]
name = interface must not import domain modules
type = forbidden
source_modules =
    pyapprox.interface
forbidden_modules =
    pyapprox.probability
    pyapprox.optimization
    pyapprox.implicitfunction
    pyapprox.ode
    pyapprox.surrogates
    pyapprox.inverse
    pyapprox.generative
    pyapprox.sensitivity
    pyapprox.pde
    pyapprox.statest
    pyapprox.expdesign

# ── Contract 3: Implicit functions under ODEs under PDEs ─────────────────
# Implicit functions (R(u; p) = 0, time-free) are the general layer; ODEs
# (time-indexed right-hand sides, steppers, trajectory sweeps) build on
# them, and PDE discretizations on both.
[importlinter:contract:physics-layers]
name = pde above ode above implicitfunction
type = layers
layers =
    pyapprox.pde
    pyapprox.ode
    pyapprox.implicitfunction

[importlinter:contract:implicitfunction-isolation]
name = implicitfunction imports only util and interface
type = forbidden
source_modules =
    pyapprox.implicitfunction
forbidden_modules =
    pyapprox.optimization
    pyapprox.ode
    pyapprox.pde
    pyapprox.surrogates
    pyapprox.probability
    pyapprox.inverse
    pyapprox.generative
    pyapprox.sensitivity
    pyapprox.statest
    pyapprox.expdesign
    pyapprox.risk

[importlinter:contract:implicitfunction-no-array-libraries]
name = implicitfunction reaches array libraries only through util
type = forbidden
source_modules =
    pyapprox.implicitfunction
forbidden_modules =
    numpy
    scipy
    torch
allow_indirect_imports = True

# ── Contract 4: Layering of probability, inverse and expdesign ───────────
[importlinter:contract:probability-isolation]
name = probability must not import inverse or expdesign
type = forbidden
source_modules =
    pyapprox.probability
forbidden_modules =
    pyapprox.inverse
    pyapprox.expdesign

[importlinter:contract:inverse-isolation]
name = inverse must not import expdesign
type = forbidden
source_modules =
    pyapprox.inverse
forbidden_modules =
    pyapprox.expdesign

# ── pde and the statistics packages stay independent ───────────────────
# A discretization needs polynomial, kernel and random-field building
# blocks, not surrogates or probability distributions: those blocks move
# out of surrogates into their own lower-level packages, and a statistics
# object reaches a PDE model only by satisfying a protocol the model owns.
# Each ignore below is an edge that exists today; the list only shrinks,
# and an entry goes when the package it reaches has moved or the consumer
# owns the protocol.
[importlinter:contract:pde-independent-of-statistics]
name = pde must not import surrogates or probability
type = forbidden
source_modules =
    pyapprox.pde
forbidden_modules =
    pyapprox.surrogates
    pyapprox.probability
ignore_imports =
    pyapprox.pde.collocation.functionals.point_evaluation -> pyapprox.surrogates.affine.univariate.lagrange
    pyapprox.pde.collocation.quadrature.collocation_quadrature -> pyapprox.surrogates.affine.univariate.globalpoly.jacobi
    pyapprox.pde.collocation.quadrature.collocation_quadrature -> pyapprox.surrogates.affine.univariate.globalpoly.quadrature
    pyapprox.pde.collocation.quadrature.collocation_quadrature -> pyapprox.surrogates.affine.univariate.lagrange
    pyapprox.pde.coupling.basis -> pyapprox.surrogates.affine.univariate.globalpoly.jacobi
    pyapprox.pde.coupling.basis -> pyapprox.surrogates.affine.univariate.lagrange
    pyapprox.pde.decomposition.interface.basis -> pyapprox.surrogates.affine.univariate.globalpoly
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kernels.matern
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kernels.protocols
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kle.galerkin_kle
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kle.mesh_kle
    pyapprox.pde.galerkin.kle_factory -> pyapprox.surrogates.kle.spde_kle
    pyapprox.pde.galerkin.kle_factory -> pyapprox.surrogates.kle.utils
    pyapprox.pde.rom.trial_space -> pyapprox.surrogates.kle
    pyapprox.pde.galerkin.noise_mass -> pyapprox.probability.protocols.covariance

[importlinter:contract:statistics-independent-of-pde]
name = surrogates and probability must not import pde
type = forbidden
source_modules =
    pyapprox.surrogates
    pyapprox.probability
forbidden_modules =
    pyapprox.pde
