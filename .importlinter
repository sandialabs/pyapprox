[importlinter]
root_package = pyapprox
include_external_packages = True

# ── Contract 1: No circular dependencies between top-level modules ───────
[importlinter:contract:acyclic]
name = No circular dependencies between top-level modules
type = acyclic_siblings
ancestors =
    pyapprox
ignore_imports =
    # TECH DEBT: real cycle; potential fix: extract bayesian optimization into its own top-level module
    pyapprox.optimization.bayesian.fitter_adapter -> pyapprox.surrogates.gaussianprocess.fitters.maximum_likelihood_fitter
    pyapprox.optimization.bayesian.fitter_adapter -> pyapprox.surrogates.gaussianprocess.fitters.fixed_hyperparameter_fitter
    pyapprox.optimization.bayesian.fitter_adapter -> pyapprox.surrogates.gaussianprocess.fitters.incremental_fitter

# ── Contract 2: Foundation modules must not import domain modules ────────
[importlinter:contract:util-isolation]
name = util must not import domain modules
type = forbidden
source_modules =
    pyapprox.util
forbidden_modules =
    pyapprox.interface
    pyapprox.probability
    pyapprox.optimization
    pyapprox.implicitfunction
    pyapprox.ode
    pyapprox.surrogates
    pyapprox.inverse
    pyapprox.generative
    pyapprox.sensitivity
    pyapprox.pde
    pyapprox.statest
    pyapprox.expdesign

[importlinter:contract:interface-isolation]
name = interface must not import domain modules
type = forbidden
source_modules =
    pyapprox.interface
forbidden_modules =
    pyapprox.probability
    pyapprox.optimization
    pyapprox.implicitfunction
    pyapprox.ode
    pyapprox.surrogates
    pyapprox.inverse
    pyapprox.generative
    pyapprox.sensitivity
    pyapprox.pde
    pyapprox.statest
    pyapprox.expdesign

# ── Contract 3: Implicit functions under ODEs under PDEs ─────────────────
# Implicit functions (R(u; p) = 0, time-free) are the general layer; ODEs
# (time-indexed right-hand sides, steppers, trajectory sweeps) build on
# them, and PDE discretizations on both.
[importlinter:contract:physics-layers]
name = pde above ode above implicitfunction
type = layers
layers =
    pyapprox.pde
    pyapprox.ode
    pyapprox.implicitfunction

[importlinter:contract:implicitfunction-isolation]
name = implicitfunction imports only util and interface
type = forbidden
source_modules =
    pyapprox.implicitfunction
forbidden_modules =
    pyapprox.optimization
    pyapprox.ode
    pyapprox.pde
    pyapprox.surrogates
    pyapprox.probability
    pyapprox.inverse
    pyapprox.generative
    pyapprox.sensitivity
    pyapprox.statest
    pyapprox.expdesign
    pyapprox.risk

[importlinter:contract:implicitfunction-no-array-libraries]
name = implicitfunction reaches array libraries only through util
type = forbidden
source_modules =
    pyapprox.implicitfunction
forbidden_modules =
    numpy
    scipy
    torch
allow_indirect_imports = True

# ── Contract 4: Layering of probability, inverse and expdesign ───────────
[importlinter:contract:probability-isolation]
name = probability must not import inverse or expdesign
type = forbidden
source_modules =
    pyapprox.probability
forbidden_modules =
    pyapprox.inverse
    pyapprox.expdesign

[importlinter:contract:inverse-isolation]
name = inverse must not import expdesign
type = forbidden
source_modules =
    pyapprox.inverse
forbidden_modules =
    pyapprox.expdesign

# ── pde and the statistics packages stay independent ───────────────────
# A discretization needs polynomial, kernel and random-field building
# blocks, not surrogates or probability distributions: those blocks move
# out of surrogates into their own lower-level packages, and a statistics
# object reaches a PDE model only by satisfying a protocol the model owns.
# Each ignore below is an edge that exists today; the list only shrinks,
# and an entry goes when the package it reaches has moved or the consumer
# owns the protocol.
[importlinter:contract:pde-independent-of-statistics]
name = pde must not import surrogates or probability
type = forbidden
source_modules =
    pyapprox.pde
forbidden_modules =
    pyapprox.surrogates
    pyapprox.probability
ignore_imports =
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kernels.matern
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kernels.protocols
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kle.galerkin_kle
    pyapprox.pde.field_maps.kle_factory -> pyapprox.surrogates.kle.mesh_kle
    pyapprox.pde.rom.trial_space -> pyapprox.surrogates.kle
    pyapprox.pde.galerkin.noise_mass -> pyapprox.probability.protocols.covariance

[importlinter:contract:statistics-independent-of-pde]
name = surrogates and probability must not import pde
type = forbidden
source_modules =
    pyapprox.surrogates
    pyapprox.probability
forbidden_modules =
    pyapprox.pde

# ── polynomials imports nothing above its level, and not probability ────
# Univariate bases, Leja sequences and induced sampling are building
# blocks for surrogates, quadrature and PDE discretizations alike, so
# polynomials imports only packages at or below its own level.
# probability shares that level but is forbidden too: a marginal supplies
# its recurrence coefficients through a protocol polynomials owns. Each
# ignore below is an edge that exists today; the list only shrinks, and an
# entry goes when the code it reaches moves down or the protocol becomes
# owned by polynomials.
[importlinter:contract:polynomials-level]
name = polynomials must not import probability or packages above it
type = forbidden
source_modules =
    pyapprox.polynomials
forbidden_modules =
    pyapprox.probability
    pyapprox.ode
    pyapprox.statest
    pyapprox.pde
    pyapprox.surrogates
    pyapprox.inverse
    pyapprox.generative
    pyapprox.expdesign
    pyapprox.sensitivity
ignore_imports =
    pyapprox.polynomials.induced -> pyapprox.probability.joint.independent
    pyapprox.polynomials.univariate.globalpoly.continuous_numeric -> pyapprox.probability.protocols.distribution
    pyapprox.polynomials.univariate.piecewisepoly.measure_rule -> pyapprox.probability.protocols.distribution
    pyapprox.polynomials.univariate.registry -> pyapprox.probability
    pyapprox.polynomials.univariate.registry -> pyapprox.probability.protocols.distribution
    pyapprox.polynomials.induced -> pyapprox.surrogates.affine.protocols.multivariate_basis
    pyapprox.polynomials.leja.multivariate -> pyapprox.surrogates.affine.protocols
    pyapprox.polynomials.leja.univariate -> pyapprox.surrogates.affine.protocols

# ── Contract: the coupling is stack-neutral ──────────────────────────────
# Subdomain responses reach the coupling through protocols it owns; only
# pde.coupling.stacks builds them from a discretization stack's objects,
# so the coupling can leave pyapprox as its own package with each stack an
# optional extra. Indirect imports count: a core module may not reach a
# stack through anything else either.
[importlinter:contract:coupling-stack-neutral]
name = the coupling core imports no discretization stack
type = forbidden
source_modules =
    pyapprox.pde.coupling
forbidden_modules =
    pyapprox.pde.collocation
    pyapprox.pde.galerkin
    pyapprox.pde.models
    skfem
ignore_imports =
    pyapprox.pde.coupling.stacks.** -> pyapprox.pde.collocation.**
    pyapprox.pde.coupling.stacks.** -> pyapprox.pde.galerkin.**
    pyapprox.pde.coupling.stacks.** -> pyapprox.pde.models.**

# The stacks know nothing of the coupling.
[importlinter:contract:stacks-independent-of-coupling]
name = discretization stacks do not import the coupling
type = forbidden
source_modules =
    pyapprox.pde.collocation
    pyapprox.pde.galerkin
    pyapprox.pde.models
forbidden_modules =
    pyapprox.pde.coupling
    pyapprox.polynomials.univariate.transformed -> pyapprox.surrogates.affine.protocols.basis1d
